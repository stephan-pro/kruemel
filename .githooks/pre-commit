#!/bin/sh
# Before each commit: look for secrets in the staged changes only (scripts/scan-secrets.mjs),
# then check formatting and linting of staged files (Q10). Purely checking, nothing is rewritten;
# fix with `npm run fix`, stage again, commit again.
node scripts/scan-secrets.mjs || exit 1
npx biome check --staged --no-errors-on-unmatched || {
  echo "❌ Commit abgebrochen: Biome hat Fehler gefunden (siehe oben). Korrektur: npm run fix"
  exit 1
}
