#!/bin/sh
# Formats and lints staged files before each commit (Q10).
# Fixed files are staged again; remaining errors stop the commit.
npx biome check --write --staged --no-errors-on-unmatched || {
  echo "❌ Commit abgebrochen: Biome hat Fehler gefunden (siehe oben)."
  exit 1
}
git update-index --again
