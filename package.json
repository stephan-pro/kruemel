{
  "name": "kruemel",
  "version": "0.1.0",
  "private": true,
  "description": "Haushaltsaufgaben für zwei Personen planen",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "vite",
    "demo": "vite --mode demo --open",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e && vite build --ssr scripts/fake-server.ts --outDir dist-fake",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "fix": "biome check --write .",
    "check:db": "node scripts/check-db.mjs",
    "try:sign-in": "node scripts/try-sign-in.mjs",
    "test": "vitest",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-preact": "^1.59.0",
    "preact": "^11.0.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@block65/webcrypto-web-push": "2.0.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
