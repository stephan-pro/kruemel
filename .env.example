# Vorlage für .env.local (nie ins Repository; .gitignore schließt sie aus).
# Beide Supabase-Werte sind öffentlich: Supabase-Dashboard → Project Settings → API Keys / Data API.
# Geheime Schlüssel (secret / service_role), das Datenbank-Passwort und das Gmail-App-Passwort
# gehören NICHT hierher.

# Speicher der App: local (wie bisher, nur im Browser) | supabase (gemeinsam, ab E2-3).
VITE_BACKEND=local
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<öffentlicher-schlüssel>
